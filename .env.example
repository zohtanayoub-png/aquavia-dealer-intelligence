# =============================================================================
# AQUAVIA DEALER INTELLIGENCE — environment configuration
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# =============================================================================

# -----------------------------------------------------------------------------
# DATABASE (required)
# -----------------------------------------------------------------------------
# PostgreSQL connection string.
# Local dev example:   postgresql://postgres:postgres@127.0.0.1:5432/aquavia
# Neon / Supabase / Vercel Postgres: copy the pooled connection string they give you.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/aquavia?schema=public"

# Direct (non-pooled) connection, used by `prisma migrate`.
# On Neon/Supabase/Vercel Postgres, DATABASE_URL is the POOLED string and
# DIRECT_URL is the DIRECT one. If your provider has no pooler, set both
# to the same value — this variable must always be present.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/aquavia?schema=public"

# -----------------------------------------------------------------------------
# GOOGLE PLACES API (New) — company discovery + verification
# -----------------------------------------------------------------------------
# Enable "Places API (New)" in Google Cloud Console and create an API key.
# Without this key the application still runs, but company discovery is disabled
# and the Settings page will report the integration as NOT CONFIGURED.
GOOGLE_PLACES_API_KEY=

# -----------------------------------------------------------------------------
# TAVILY — web research / enrichment
# -----------------------------------------------------------------------------
# https://tavily.com — used to research brands carried, showroom evidence,
# founding year, decision makers and social profiles.
# Without this key, companies are still discovered and scored from Google Places
# data alone, and every research-only field stays UNKNOWN.
TAVILY_API_KEY=

# -----------------------------------------------------------------------------
# ANTHROPIC (OPTIONAL — the application works fully without it)
# -----------------------------------------------------------------------------
# When present, Claude is used only to read already-retrieved web research text
# and extract structured facts, each one tied back to its source URL.
# It is never used to generate facts that have no source.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5

# -----------------------------------------------------------------------------
# ADMIN (OPTIONAL — leave unset unless you need it)
# -----------------------------------------------------------------------------
# Enables POST /api/relevance/reclassify, which reclassifies companies already
# in the database over HTTP. While this is unset the endpoint is DISABLED and
# returns 503, so nobody can trigger it by finding the URL.
# The CLI equivalent (`npm run db:reclassify`) never needs this.
ADMIN_TOKEN=

# -----------------------------------------------------------------------------
# APPLICATION
# -----------------------------------------------------------------------------
# Home market of the manufacturer, excluded from "distance" bonuses.
AQUAVIA_HOME_COUNTRY=ES
